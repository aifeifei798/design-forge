{
  "name": "design-forge",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "自建 UI 设计与视觉质量工作流：规则 + 配方 + 确定性检查器",
  "license": "MIT",
  "scripts": {
    "rules": "node skill/scripts/forge.mjs --list-rules",
    "recipes": "node skill/scripts/tokens.mjs recipes",
    "docs": "node tools/build-docs.mjs",
    "docs:check": "node skill/scripts/forge.mjs docs/",
    "test:bad": "node tools/expect.mjs fixtures/bad.html 18",
    "test:good": "node tools/expect.mjs fixtures/good.html 0",
    "test": "npm run -s test:bad && npm run -s test:good && npm run -s docs && npm run -s docs:check && echo 'fixtures + docs ok'",
    "link": "node tools/link.mjs"
  }
}
